{
  "name": "safari-journal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Static travel companion site for the Ryan Party South Africa & Zimbabwe safari, September 2026.",
  "scripts": {
    "predev": "node scripts/build-docs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-docs.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild:private": "node scripts/build-docs.mjs --private",
    "build:private": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "download-images": "node scripts/download-images.js"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
